# Tier 1: Nginx do kaam karta hai:
#  1) static web page (HTML/JS) serve karta hai
#  2) /api/ se shuru hone wali requests ko backend (Tier 2) ko forward karta hai
# ${BACKEND_HOST} aur ${BACKEND_PORT} container start hote waqt environment se bhare jate hain.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Kubernetes probe ke liye
    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        try_files $uri /index.html;
    }
}
